{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omp-desk",
  "version": "0.1.0",
  "identifier": "dev.omp.omp-desk",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "omp-desk",
        "width": 1400,
        "height": 800,
        "minWidth": 900,
        "minHeight": 480,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-gpu --enable-gpu-rasterization --enable-zero-copy --enable-native-gpu-memory-buffers --ignore-gpu-blocklist --enable-features=CanvasOopRasterization"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
